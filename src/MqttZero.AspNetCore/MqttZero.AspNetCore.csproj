<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MqttZero.AspNetCore</RootNamespace>
    <AssemblyName>MqttZero.AspNetCore</AssemblyName>
    <Description>ASP.NET Core Kestrel hosting for MQTTZero.</Description>
    <PackageId>MqttZero.AspNetCore</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MqttZero.Server\MqttZero.Server.csproj" />
    <InternalsVisibleTo Include="MqttZero.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
