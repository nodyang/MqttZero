<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <RootNamespace>MqttZero.AspNetCore.Dashboard</RootNamespace>
    <AssemblyName>MqttZero.AspNetCore.Dashboard</AssemblyName>
    <Description>Optional MQTTZero management dashboard.</Description>
    <PackageId>MqttZero.AspNetCore.Dashboard</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MqttZero.AspNetCore\MqttZero.AspNetCore.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*">
      <LogicalName>MqttZeroDashboard/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
