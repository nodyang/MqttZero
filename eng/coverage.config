<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <IncludeTestAssembly>false</IncludeTestAssembly>
  <ExcludeAssembliesWithoutSources>MissingAll</ExcludeAssembliesWithoutSources>
  <CodeCoverage>
    <ExcludeCompilerAutoGeneratedModules>true</ExcludeCompilerAutoGeneratedModules>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]MqttZero\.dll$</ModulePath>
        <ModulePath>.*[\\/]MqttZero\.Server\.dll$</ModulePath>
        <ModulePath>.*[\\/]MqttZero\.AspNetCore\.dll$</ModulePath>
        <ModulePath>.*[\\/]MqttZero\.AspNetCore\.Dashboard\.dll$</ModulePath>
      </Include>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
